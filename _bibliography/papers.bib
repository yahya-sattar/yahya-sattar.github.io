  author = {Sattar, Yahya and Jedra, Yassir and Fazel, Maryam and Dean, Sarah},
  title = {Bilinear System Identification: A Unified Finite-Sample Analysis},
  journal = {In submission to the IFAC Journal of Systems and Control (JSC)},
  year = {2026},
  abbr = {JSC},
  preview = {JSC_2026.png},
