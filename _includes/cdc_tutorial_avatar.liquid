{% comment %} Round headshot for the CDC tutorial page; falls back to initials when no photo is set. {% endcomment %}
{% assign person = include.person %}
{% if person.photo %}
  <img class="tut-avatar" src="{{ person.photo | prepend: '/assets/img/' | relative_url }}" alt="{{ person.name }}">
{% else %}
  {% assign name_parts = person.name | split: ' ' %}
  <div class="tut-avatar" aria-hidden="true">
    {{ name_parts.first | slice: 0 -}}
    {{- name_parts.last | slice: 0 }}
  </div>
{% endif %}
